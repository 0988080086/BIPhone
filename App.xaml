<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BIPhone"
             x:Class="BIPhone.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Style cho các nút lọc trạng thái Đơn hàng -->
            <Style x:Key="OrderFilterBtnStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#F5F5F5" />
                <Setter Property="TextColor" Value="#333333" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="Padding" Value="14,0" />

                <!-- Đổi BorderThickness thành BorderWidth -->
                <Setter Property="BorderWidth" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>