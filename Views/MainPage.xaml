<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BIPhone.Views.MainPage"
    x:Name="mainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:BIPhone"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- MÀU CHUNG -->
            <Color x:Key="ShopeeOrange">#EE4D2D</Color>
            <Color x:Key="LightBackground">#F5F5F5</Color>
            <Color x:Key="TextDark">#333333</Color>
            <Color x:Key="TextGray">#777777</Color>

            <!-- STYLES -->
            <Style x:Key="MenuButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#333333" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Margin" Value="2,0" />
            </Style>

            <Style x:Key="OrderFilterBtnStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#555555" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <!-- CONVERTERS: Dùng converters: để trỏ tới namespace BIPhone -->
            <converters:StringToVisibilityConverter x:Key="StringHasValueConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- ========================================================= -->
    <!-- TOÀN BỘ MAINPAGE -->
    <!-- ========================================================= -->
    <Grid RowDefinitions="Auto,Auto,*,50" BackgroundColor="#F5F5F5">
        <Grid   Grid.Row="0"
                Padding="10,8"
                BackgroundColor="{StaticResource ShopeeOrange}"
                HeightRequest="30"                
                ColumnSpacing="8">
                <!-- Label duy nhất phủ trọn 1 cell của Grid -->
                <Label x:Name="lblEventStatus"
                   Text="Trạng thái hệ thống..."
                   TextColor="White"
                   FontSize="13"
                   FontAttributes="Bold"
                   Margin="0,-4,0,0"
                   BackgroundColor="Transparent"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
        </Grid>

        <!-- MENU NGANG DẠNG SCROLL ĐỘNG -->
        <Grid Grid.Row="1"
              BackgroundColor="#F5F5F5"
              Padding="0,6">
            <ScrollView HorizontalScrollBarVisibility="Never" 
                Orientation="Horizontal">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding VisibleMenuItems}"
                               Spacing="12"
                               Padding="12,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid RowDefinitions="Auto, Auto" 
                          RowSpacing="4"
                          WidthRequest="65">

                                <Grid.GestureRecognizers>
                                    <!-- Binding trực tiếp về ViewModel của mainPage -->
                                    <TapGestureRecognizer Command="{Binding BindingContext.MenuItemCommand, Source={x:Reference mainPage}}" 
                                                  CommandParameter="{Binding Id}" />
                                </Grid.GestureRecognizers>

                                <!-- Border Icon (Bật InputTransparent để nhận Tap mượt hơn ở Grid cha) -->
                                <Border Grid.Row="0"
                                BackgroundColor="#FFF2EE"
                                HeightRequest="44"
                                WidthRequest="44"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 22"
                                StrokeThickness="0"
                                InputTransparent="True">
                                    <Label Text="{Binding Icon}"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                                </Border>

                                <!-- Title -->
                                <Label Grid.Row="1"
                               Text="{Binding Title}"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation"
                               TextColor="#1E293B"
                               InputTransparent="True" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ===================================================== -->
        <!-- 2. CONTENT CỦA 6 TAB -->
        <!-- ===================================================== -->
        <Grid x:Name="GridMainCONTENT" Grid.Row="2">
            <!-- TAB A - EXECUTIVE DASHBOARD (TRANG CHỦ ĐIỀU HÀNH) -->
            <ScrollView x:Name="SvDashboard"
                Grid.Row="2"
                IsVisible="True"
                Padding="12,10,12,24">
                <VerticalStackLayout Spacing="16">

                    <!-- 1. HEADER: CHÀO SẾP & LỌC THỜI GIAN -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Chào Sếp, Chúc một ngày tốt lành! 👋" FontSize="12" TextColor="#64748B" />
                            <Label Text="Báo cáo Tổng quan" FontAttributes="Bold" FontSize="18" TextColor="#0F172A" />
                        </VerticalStackLayout>

                        <!-- Nút chọn thời gian báo cáo -->
                        <Border Grid.Column="1" BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 16" Padding="10,6" StrokeThickness="0">
                            <Label Text="📅 Hôm nay ▾" FontSize="11" FontAttributes="Bold" TextColor="#334155"/>
                        </Border>
                    </Grid>

                    <!-- 2. THẺ HERO: TÌNH HÌNH TÀI CHÍNH & TIẾN ĐỘ CHỈ TIÊU (KPI) -->
                    <Border BackgroundColor="#0F172A" StrokeShape="RoundRectangle 12" Padding="16,14" StrokeThickness="0">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="THU CHỈ KẾT TOÁN (TIỀN MẶT + CỬA HÀNG)" FontSize="11" TextColor="#94A3B8" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="KPI: 85%" FontSize="11" TextColor="#38BDF8" FontAttributes="Bold"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, *">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Doanh thu thực" FontSize="11" TextColor="#CBD5E1"/>
                                    <Label Text="{Binding DoanhThu, FallbackValue='45.200.000đ'}" FontSize="20" FontAttributes="Bold" TextColor="#38BDF8"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Lợi nhuận gộp (Ước tính)" FontSize="11" TextColor="#CBD5E1"/>
                                    <Label Text="{Binding LoiNhuan, FallbackValue='14.800.000đ'}" FontSize="20" FontAttributes="Bold" TextColor="#4ADE80"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Thanh Tiến Độ KPI -->
                            <ProgressBar Progress="0.85" ProgressColor="#38BDF8" HeightRequest="6"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. PHÊ DUYỆT & NÓNG (Actionable Items - Chủ doanh nghiệp duyệt ngay) -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="CẦN SẾP XỬ LÝ NGAY ⚡" FontSize="12" FontAttributes="Bold" TextColor="#991B1B"/>
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <!-- Cảnh báo 1: Duyệt chi -->
                            <Border Grid.Column="0" BackgroundColor="#FEF2F2" Stroke="#FECACA" StrokeShape="RoundRectangle 8" Padding="10">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Duyệt Phiếu Chi" FontSize="11" TextColor="#991B1B" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="💸" FontSize="12"/>
                                    </Grid>
                                    <Label Text="3 phiếu (12.500K)" FontSize="14" FontAttributes="Bold" TextColor="#7F1D1D"/>
                                    <Label Text="Chờ phê duyệt >" FontSize="10" TextColor="#DC2626" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Cảnh báo 2: Cuộc gọi nhỡ VIP -->
                            <Border Grid.Column="1" BackgroundColor="#FFFBEB" Stroke="#FDE68A" StrokeShape="RoundRectangle 8" Padding="10">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Giao dịch Tắc nghẽn" FontSize="11" TextColor="#92400E" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="⚠️" FontSize="12"/>
                                    </Grid>
                                    <Label Text="5 đơn hoãn giao" FontSize="14" FontAttributes="Bold" TextColor="#78350F"/>
                                    <Label Text="Xem chi tiết >" FontSize="10" TextColor="#D97706" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- 4. LỐI TẮT THAO TÁC NHANH (Quick Actions) -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="THAO TÁC NHANH" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                        <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="8">
                            <!-- Nút 1: Tạo đơn -->
                            <Border Grid.Column="0" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 8" Padding="8">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="➕" FontSize="18" HorizontalOptions="Center"/>
                                    <Label Text="Tạo đơn" FontSize="10" TextColor="#334155" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                            <!-- Nút 2: Quét mã -->
                            <Border Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 8" Padding="8">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="📷" FontSize="18" HorizontalOptions="Center"/>
                                    <Label Text="Quét mã" FontSize="10" TextColor="#334155" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                            <!-- Nút 3: Gọi điện (BIPhone) -->
                            <Border Grid.Column="2" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 8" Padding="8">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="📞" FontSize="18" HorizontalOptions="Center"/>
                                    <Label Text="Tổng đài" FontSize="10" TextColor="#334155" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                            <!-- Nút 4: Sổ nợ -->
                            <Border Grid.Column="3" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 8" Padding="8">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="📖" FontSize="18" HorizontalOptions="Center"/>
                                    <Label Text="Sổ nợ" FontSize="10" TextColor="#334155" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- 5. PHÂN TÍCH HIỆU SUẤT VẬN HÀNH (Operation Status) -->
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10" Padding="12">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="TÌNH HÌNH VẬN HÀNH HÔM NAY" FontSize="12" FontAttributes="Bold" TextColor="#1E293B"/>

                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Đơn thành công" FontSize="10" TextColor="#64748B"/>
                                    <Label Text="28 / 32" FontSize="15" FontAttributes="Bold" TextColor="#16A34A"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Cuộc gọi tư vấn" FontSize="10" TextColor="#64748B"/>
                                    <Label Text="45 cuộc" FontSize="15" FontAttributes="Bold" TextColor="#2563EB"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="Khách mới" FontSize="10" TextColor="#64748B"/>
                                    <Label Text="+12 khách" FontSize="15" FontAttributes="Bold" TextColor="#9333EA"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 6. HOẠT ĐỘNG GẦN ĐÂY (Real-time Feed) -->
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="NHẬT KÝ HOẠT ĐỘNG BÁN HÀNG" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                            <Label Grid.Column="1" Text="Xem tất cả" FontSize="11" TextColor="#2563EB" FontAttributes="Bold"/>
                        </Grid>

                        <!-- Item 1 -->
                        <Border BackgroundColor="White" Stroke="#F1F5F9" StrokeShape="RoundRectangle 6" Padding="10,8">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Text="🛒" FontSize="14" VerticalOptions="Center" Margin="0,0,8,0"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Đơn hàng #DH1024 - Anh Tuấn" FontSize="12" FontAttributes="Bold" TextColor="#1E293B"/>
                                    <Label Text="Thanh toán CK • 1.250.000đ" FontSize="10" TextColor="#64748B"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="2 phút trước" FontSize="10" TextColor="#94A3B8" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Item 2 -->
                        <Border BackgroundColor="White" Stroke="#F1F5F9" StrokeShape="RoundRectangle 6" Padding="10,8">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Text="📞" FontSize="14" VerticalOptions="Center" Margin="0,0,8,0"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Cuộc gọi đến từ 0988.080.***" FontSize="12" FontAttributes="Bold" TextColor="#1E293B"/>
                                    <Label Text="Thời lượng: 3m 45s • NV Hải" FontSize="10" TextColor="#64748B"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="15 phút trước" FontSize="10" TextColor="#94A3B8" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- TAB B - SẢN PHẨM -->
            <Grid x:Name="GridSanPham" RowDefinitions="Auto,Auto,*" RowSpacing="10" Padding="10">

                <!-- 1. Bổ sung Tổng số sản phẩm và Label Đồng bộ sản phẩm -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <StackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label x:Name="lblTongMatHang"
						   Text="Tổng SP: 0"
						   FontSize="15"
						   FontAttributes="Bold"
						   TextColor="#333333"
						   VerticalOptions="Center" />
                    </StackLayout>

                    <Label Grid.Column="1" x:Name="lblDongBoHangHoa"
						   Text="🔄 Đồng bộ sản phẩm"
						   FontSize="14"
						   FontAttributes="Bold"
						   TextColor="#007AFF"
						   VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDongBoHangHoaClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- 2. Thanh tìm kiếm đa năng (Chuyển sang Grid.Row="1") -->
                <Frame Grid.Row="1"
					   Padding="5,0"
					   CornerRadius="12"
					   BorderColor="#E0E0E0"
					   HasShadow="True"
					   BackgroundColor="White">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2" HeightRequest="46">

                        <!-- Ô nhập chữ tìm kiếm -->
                        <Entry x:Name="txtSearchSanPham"
						   Grid.Column="0"
						   Placeholder="Tìm tên, mã, barcode sản phẩm..."
						   VerticalOptions="Center"
						   ClearButtonVisibility="WhileEditing"
						   FontSize="14" />

                        <!-- Micro (Voice to Text) -->
                        <Button 
                            x:Name="btnVoiceSearchSanPham"
                            Grid.Column="1"
							Text="🎙️"
							Clicked="OnVoiceToTextClicked"
							FontSize="18"
							HeightRequest="36" WidthRequest="36"
							Padding="0" BackgroundColor="Transparent" />

                        <!-- Camera Scan Barcode -->
                        <Button Grid.Column="2"
							Text="📷"
							Clicked="OnScanBarcodeClicked"
							FontSize="18"
							HeightRequest="36" WidthRequest="36"
							Padding="0" BackgroundColor="Transparent" />

                        <!-- Nút Tìm kiếm (Icon Kính lúp) -->
                        <Button Grid.Column="3"
							Text="🔍"
							Clicked="OnTimKiemSanPhamClicked"
							FontSize="16"
							BackgroundColor="Transparent"
							TextColor="#333333"
							CornerRadius="8"
							HeightRequest="32" WidthRequest="36"								
							Padding="0"/>
                    </Grid>
                </Frame>

                <!-- 3. Danh sách sản phẩm dạng Card (Chuyển sang Grid.Row="2") -->
                <RefreshView Grid.Row="2" x:Name="refViewProducts" Refreshing="OnRefreshingProducts">
                    <CollectionView x:Name="cvProducts" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="10" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="False" BackgroundColor="White">
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">

                                        <!-- Ảnh đại diện -->
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" StrokeThickness="0" HeightRequest="90" WidthRequest="90">
                                            <Image Source="{Binding HinhAnh, TargetNullValue='no_image.png'}" Aspect="AspectFill" />
                                        </Border>

                                        <!-- Thông tin sản phẩm -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">

                                            <!-- Tên sản phẩm -->
                                            <Label Text="{Binding TenSanPham}" FontAttributes="Bold" FontSize="15" TextColor="#333333" MaxLines="2" LineBreakMode="TailTruncation"/>

                                            <!-- Mã hàng / Barcode -->
                                            <Label Text="{Binding MaHang, StringFormat='Mã: {0}'}" FontSize="12" TextColor="#666666"/>

                                            <!-- Giá bán, Tồn kho & Nút mua -->
                                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Margin="0,4,0,0">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding GiaBan, StringFormat='{0:N0} đ'}"
                                               FontSize="15" FontAttributes="Bold" TextColor="#EE4D2D"/>
                                                    <Label Text="{Binding TonKho, StringFormat='Tồn kho: {0:N0}'}"
                                               FontSize="12" FontAttributes="Bold" TextColor="#2E7D32"/>
                                                </VerticalStackLayout>

                                                <Button Grid.Column="1"
                                            Text="+ Giỏ hàng"
                                            Clicked="OnAddToCartClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#E8F5E9"
                                            TextColor="#2E7D32"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            CornerRadius="6"
                                            HeightRequest="32"
                                            Padding="10,0"
                                            VerticalOptions="End"/>
                                            </Grid>

                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <!-- Giao diện khi danh sách trống -->
                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="0,50">
                                <Label Text="Không tìm thấy sản phẩm nào" TextColor="#888888" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                    </CollectionView>
                </RefreshView>

            </Grid>

            <!-- TAB C - CUỘC GỌI -->
            <Grid x:Name="GridCall" RowDefinitions="Auto,Auto,*" IsVisible="False" Padding="10">

                <!-- 1. Header: Tổng số khách hàng & Nút Đồng bộ -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10" VerticalOptions="Center">
                    <StackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label x:Name="lblTongKhachHang"
                           Text="Tổng KH: 0"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#EE4D2D"
                           VerticalOptions="Center" />
                    </StackLayout>

                    <Label Grid.Column="1" x:Name="lblDongBoKhachHang"
                       Text="Đồng bộ khách hàng"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#EE4D2D"
                       VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDongBoKhachHangClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- 2. Thanh tìm kiếm cuộc gọi (Style Frame Bo Tròn) -->
                <Frame Grid.Row="1"
                   Margin="0,0,0,8"
                   Padding="5,0"
                   CornerRadius="12"
                   BorderColor="#E0E0E0"
                   HasShadow="True"
                   BackgroundColor="White">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="2" HeightRequest="44">

                        <!-- 1. Ô nhập từ khóa tìm kiếm cuộc gọi -->
                        <Entry x:Name="txtSearchCuocGoi"
                           Grid.Column="0"
                           Placeholder="Tìm số điện thoại, tên, mã KH..."
                           VerticalOptions="Center"
                           ClearButtonVisibility="WhileEditing"
                           FontSize="13"
                           TextColor="#0F172A"
                           PlaceholderColor="#94A3B8"
                           BackgroundColor="Transparent"/>

                        <!-- 2. Nút Tìm kiếm cuộc gọi -->
                        <Button Grid.Column="1"
                            Text="🔍"
                            Clicked="OnTimKiemCuocGoiClicked"
                            FontSize="16"
                            BackgroundColor="Transparent"
                            TextColor="#333333"
                            HeightRequest="36" WidthRequest="34"
                            Padding="0"/>
                    </Grid>
                </Frame>

                <!-- 3. Danh sách Cuộc gọi với tính năng Kéo để làm mới (Pull-to-Refresh) -->
                <RefreshView Grid.Row="2" x:Name="refViewCalls" Refreshing="OnRefreshingCalls">
                    <CollectionView x:Name="cvCalls" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,0,0,2" Padding="10,0,0,0" CornerRadius="8" BorderColor="#E0E0E0" HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemCardTapped" />
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout Spacing="0">

                                        <!-- Hàng 1: Thời gian, Số điện thoại, Checkbox đã đồng bộ -->
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Label Grid.Column="0" Text="{Binding BatDau}" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding DienThoai}" FontAttributes="Bold" TextColor="#007AFF" Margin="15,0,0,0" VerticalOptions="Center"/>
                                            <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                                                <Label Text="Đã gửi:" FontSize="12" TextColor="#666666" VerticalOptions="Center"/>
                                                <CheckBox IsChecked="{Binding IsSynced}" IsEnabled="False" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,2"/>

                                        <!-- Các thông tin Mã, Tên, Địa chỉ, ĐT, Nội dung -->
                                        <!--
                                        <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                            <Label Grid.Row="0" Grid.Column="0" Text="Mã KH:" TextColor="#666666" FontSize="15" IsVisible="{Binding DtMa, Converter={StaticResource StringHasValueConverter}}"/>
                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding DtMa}" FontAttributes="Bold" FontSize="15" IsVisible="{Binding DtMa, Converter={StaticResource StringHasValueConverter}}"/>

                                            <Label Grid.Row="1" Grid.Column="0" Text="Tên KH:" TextColor="#666666" FontSize="15" IsVisible="{Binding DtTen, Converter={StaticResource StringHasValueConverter}}"/>
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding DtTen}" FontAttributes="Bold" FontSize="15" IsVisible="{Binding DtTen, Converter={StaticResource StringHasValueConverter}}"/>

                                            <Label Grid.Row="2" Grid.Column="0" Text="Địa chỉ:" TextColor="#666666" FontSize="15" IsVisible="{Binding DtDiaChi, Converter={StaticResource StringHasValueConverter}}"/>
                                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding DtDiaChi}" FontSize="15" IsVisible="{Binding DtDiaChi, Converter={StaticResource StringHasValueConverter}}"/>

                                            <Label Grid.Row="3" Grid.Column="0" Text="Đ.thoại:" TextColor="#666666" FontSize="15" IsVisible="{Binding DtDienThoai, Converter={StaticResource StringHasValueConverter}}"/>
                                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding DtDienThoai}" FontSize="15" IsVisible="{Binding DtDienThoai, Converter={StaticResource StringHasValueConverter}}"/>

                                            <Label Grid.Row="4" Grid.Column="0" Text="Nội dung:" TextColor="#666666" FontSize="15" IsVisible="{Binding NoiDung, Converter={StaticResource StringHasValueConverter}}"/>
                                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding NoiDung}" FontSize="15" TextColor="#EE4D2D" IsVisible="{Binding NoiDung, Converter={StaticResource StringHasValueConverter}}"/>
                                        </Grid>  -->
                                        
                                        <!-- Các thông tin Mã, Tên, Địa chỉ, ĐT, Nội dung -->
                                        <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">

                                            <!-- Dòng 0: Mã KH (Bên trái) + Link Xem lại cuộc gọi (Căn lề phải) -->
                                            <Label Grid.Row="0" Grid.Column="0" 
                                               Text="Mã KH:" 
                                               TextColor="#666666" 
                                               FontSize="15" 
                                               IsVisible="{Binding DtMa, Converter={StaticResource StringHasValueConverter}}"/>

                                            <Grid Grid.Row="0" Grid.Column="1" 
                                                  ColumnDefinitions="*, Auto" 
                                                  IsVisible="{Binding DtMa, Converter={StaticResource StringHasValueConverter}}">

                                                <!-- Giá trị Mã KH -->
                                                <Label Grid.Column="0" 
                                                   Text="{Binding DtMa}" 
                                                   FontAttributes="Bold" 
                                                   FontSize="15" 
                                                   VerticalOptions="Center" />

                                                <!-- Link Xem lại cuộc gọi (Chữ màu xanh đậm, bấm vào mở popup) -->
                                                <Label Grid.Column="1" 
                                                   Text="Xem lại cuộc gọi" 
                                                   TextColor="#0056B3" 
                                                   FontSize="14" 
                                                   FontAttributes="Bold"
                                                   TextDecorations="Underline"
                                                   VerticalOptions="Center" 
                                                   HorizontalOptions="End"
                                                   Margin="0,0,12,0">
                                                    
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnReviewCallTapped" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Grid>

                                            <!-- Dòng 1: Tên KH -->
                                            <Label Grid.Row="1" Grid.Column="0" Text="Tên KH:" TextColor="#666666" FontSize="15" IsVisible="{Binding DtTen, Converter={StaticResource StringHasValueConverter}}"/>
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding DtTen}" FontAttributes="Bold" FontSize="15" IsVisible="{Binding DtTen, Converter={StaticResource StringHasValueConverter}}"/>

                                            <!-- Dòng 2: Địa chỉ -->
                                            <Label Grid.Row="2" Grid.Column="0" Text="Địa chỉ:" TextColor="#666666" FontSize="15" IsVisible="{Binding DtDiaChi, Converter={StaticResource StringHasValueConverter}}"/>
                                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding DtDiaChi}" FontSize="15" IsVisible="{Binding DtDiaChi, Converter={StaticResource StringHasValueConverter}}"/>

                                            <!-- Dòng 3: Điện thoại -->
                                            <Label Grid.Row="3" Grid.Column="0" Text="Đ.thoại:" TextColor="#666666" FontSize="15" IsVisible="{Binding DtDienThoai, Converter={StaticResource StringHasValueConverter}}"/>
                                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding DtDienThoai}" FontSize="15" IsVisible="{Binding DtDienThoai, Converter={StaticResource StringHasValueConverter}}"/>

                                            <!-- Dòng 4: Nội dung -->
                                            <Label Grid.Row="4" Grid.Column="0" Text="Nội dung:" TextColor="#666666" FontSize="15" IsVisible="{Binding NoiDung, Converter={StaticResource StringHasValueConverter}}"/>
                                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding NoiDung}" FontSize="15" TextColor="#EE4D2D" IsVisible="{Binding NoiDung, Converter={StaticResource StringHasValueConverter}}"/>

                                        </Grid>

                                        <!-- Nút Thao tác -->
                                        <Grid x:Name="gridActionButtons"
                                            IsVisible="False"
                                            ColumnDefinitions="*,*,*,*,*,*"
                                            ColumnSpacing="5"
                                            Margin="0,6,0,0">
                                            <Button Grid.Column="0" Text="Gọi&#10;lại" Clicked="OnGoiLaiClicked" CommandParameter="{Binding .}" HeightRequest="38" Padding="0" FontSize="12" LineBreakMode="WordWrap" BackgroundColor="#E1F5FE" TextColor="#0288D1"/>
                                            <Button Grid.Column="1" Text="Ghi&#10;chú" Clicked="OnGhiChuClicked" CommandParameter="{Binding .}" HeightRequest="38" Padding="0" FontSize="12" LineBreakMode="WordWrap" BackgroundColor="#FFF9C4" TextColor="#F57F17"/>
                                            <Button Grid.Column="2" Text="Khách&#10;hàng" Clicked="OnKhachHangClicked" CommandParameter="{Binding .}" HeightRequest="38" Padding="0" FontSize="12" LineBreakMode="WordWrap" BackgroundColor="#FFF9C4" TextColor="#F57F17"/>
                                            <Button Grid.Column="3" Text="Bán&#10;hàng" Clicked="OnBanHangClicked" CommandParameter="{Binding .}" HeightRequest="38" Padding="0" FontSize="12" LineBreakMode="WordWrap" BackgroundColor="#E8F5E9" TextColor="#388E3C"/>
                                            <Button Grid.Column="4" Text="Nghe&#10;lại" Clicked="OnNgheLaiClicked" CommandParameter="{Binding .}" HeightRequest="38" Padding="0" FontSize="12" LineBreakMode="WordWrap" BackgroundColor="#F3E5F5" TextColor="#7B1FA2"/>
                                            <Button Grid.Column="5" Text="Chia&#10;sẻ" Clicked="OnChiaSeClicked" CommandParameter="{Binding .}" HeightRequest="38" Padding="0" FontSize="12" LineBreakMode="WordWrap" BackgroundColor="#F3E5F5" TextColor="#7B1FA2"/>
                                        </Grid>

                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>

            <!-- TAB D - GIAO HÀNG (ONLINE - TMĐT STYLE) -->
            <Grid x:Name="GridGiaoHang" RowDefinitions="Auto, Auto, *, Auto" IsVisible="false" BackgroundColor="#F1F5F9">

                <!-- 1. Thanh Tìm Kiếm, Scan Barcode & Chọn Ngày -->
                <Frame Grid.Row="0"
                       Margin="10,6"
                       Padding="5,0"
                       CornerRadius="12"
                       BorderColor="#E0E0E0"
                       HasShadow="True"
                       BackgroundColor="White">
                    <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" ColumnSpacing="2" HeightRequest="44">

                        <Entry x:Name="txtSearchGiaoHang"
                   Grid.Column="0"
                   Placeholder="Tìm mã đơn, tên, SĐT..."
                   VerticalOptions="Center"
                   ClearButtonVisibility="WhileEditing"
                   FontSize="13"
                   TextColor="#0F172A"
                   PlaceholderColor="#94A3B8"
                   BackgroundColor="Transparent"/>

                        <Button Grid.Column="1"
                    Text="📷"
                    Clicked="OnScanBarcodeGhClicked"
                    FontSize="17"
                    HeightRequest="36" WidthRequest="32"
                    Padding="0" BackgroundColor="Transparent"/>

                        <DatePicker x:Name="DpGiaoHangTuNgay" 
                        Grid.Column="2" 
                        Format="dd/MM" 
                        FontSize="12" 
                        TextColor="#1E293B" 
                        HeightRequest="36" WidthRequest="58"
                        VerticalOptions="Center"
                        BackgroundColor="Transparent"/>

                        <DatePicker x:Name="DpGiaoHangDenNgay" 
                        Grid.Column="3" 
                        Format="dd/MM" 
                        FontSize="12" 
                        TextColor="#1E293B" 
                        HeightRequest="36" WidthRequest="58"
                        VerticalOptions="Center"
                        BackgroundColor="Transparent"/>

                        <Button Grid.Column="4"
                    Text="🔍"
                    Clicked="OnTimKiemGiaoHangClicked"
                    FontSize="16"
                    BackgroundColor="Transparent"
                    TextColor="#333333"
                    HeightRequest="36" WidthRequest="34"
                    Padding="0"/>
                    </Grid>
                </Frame>

                <!-- 2. Filter Trạng Thái (Chips) -->
                <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="10,6" BackgroundColor="White">
                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="BtnFilterTatCa" Text="Tất cả" Clicked="BtnFilterTatCa_Clicked" FontSize="12" HeightRequest="28" Padding="12,0" VerticalOptions="Center" CornerRadius="8" BackgroundColor="#EE4D2D" TextColor="White"/>
                        <Button x:Name="BtnFilterChoLay" Text="Chờ giao" Clicked="BtnFilterChoLay_Clicked" FontSize="12" HeightRequest="28" Padding="12,0" VerticalOptions="Center" CornerRadius="8" BackgroundColor="#F1F5F9" TextColor="#475569"/>
                        <Button x:Name="BtnFilterDangGiao" Text="Đang giao" Clicked="BtnFilterDangGiao_Clicked" FontSize="12" HeightRequest="28" Padding="12,0" VerticalOptions="Center" CornerRadius="8" BackgroundColor="#F1F5F9" TextColor="#475569"/>
                        <Button x:Name="BtnFilterDaGiao" Text="Đã giao" Clicked="BtnFilterDaGiao_Clicked" FontSize="12" HeightRequest="28" Padding="12,0" VerticalOptions="Center" CornerRadius="8" BackgroundColor="#F1F5F9" TextColor="#475569"/>
                        <Button x:Name="BtnFilterDaHuy" Text="Đã hủy" Clicked="BtnFilterDaHuy_Clicked" FontSize="12" HeightRequest="28" Padding="12,0" VerticalOptions="Center" CornerRadius="8" BackgroundColor="#F1F5F9" TextColor="#475569"/>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- 3. Danh Sách Vận Đơn (CollectionView Style Bill) -->
                <Grid Grid.Row="2">
                    <CollectionView x:Name="CvGiaoHangList" Margin="8,4">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 12" Margin="0,4" Padding="12" BackgroundColor="White">

                                    <!-- Chạm vào bất kỳ đâu trên Card đơn hàng để Mở/Ẩn thanh công cụ nút bấm -->
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemGiaoHangTapped" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="8">

                                        <!-- KHỐI 1: HEADER BILL (MÃ ĐƠN & BẠCH KIM BADGE + ICON THAO TÁC) -->
                                        <Grid ColumnDefinitions="*, Auto">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                                <Label Text="📦" FontSize="13"/>
                                                <Label Text="{Binding GhSo, StringFormat='Đơn #{0}'}" FontAttributes="Bold" TextColor="#0F172A" FontSize="14"/>
                                                <Label Text="{Binding NgayLapPhieu, StringFormat='({0:dd/MM/yyyy HH:mm})'}" FontSize="11" TextColor="#64748B" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                <Border BackgroundColor="{Binding MauTinhTrangHex}" Padding="8,3" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                                    <Label Text="{Binding TenTinhTrang}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                                                </Border>
                                                <!-- Icon gợi ý ẩn/hiện bảng nút bấm -->
                                                <Label Text="{Binding IconMoRong}" FontSize="12" TextColor="#64748B" VerticalOptions="Center" Margin="2,0,0,0"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#E2E8F0"/>

                                        <!-- KHỐI 2: THÔNG TIN KHÁCH HÀNG & TÌNH TRẠNG (Luôn hiển thị) -->
                                        <VerticalStackLayout Spacing="3">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" Text="{Binding DtTen, StringFormat='👤 {0}'}" FontAttributes="Bold" TextColor="#1E293B" FontSize="13" LineBreakMode="TailTruncation"/>
                                                <Label Grid.Column="1" Text="{Binding DtMa, StringFormat='[{0}]'}" FontSize="11" TextColor="#64748B"/>
                                            </Grid>

                                            <Label Text="{Binding DtDienThoai, StringFormat='📞 {0}'}" FontSize="12" TextColor="#2563EB" FontAttributes="Bold"/>
                                            <Label Text="{Binding DtDiaChi, StringFormat='📍 {0}'}" FontSize="12" TextColor="#475569" LineBreakMode="WordWrap"/>

                                            <!-- Bổ sung hiển thị Tình trạng vào cuối thông tin đơn hàng -->
                                            <Label Text="{Binding TenTinhTrang, StringFormat='• Tình trạng: {0}'}" FontSize="12" TextColor="#D97706" FontAttributes="Bold" Margin="0,2,0,0"/>
                                        </VerticalStackLayout>

                                        <BoxView HeightRequest="1" Color="#E2E8F0"/>

                                        <!-- KHỐI 3: HIỂN THỊ SẢN PHẨM (Luôn hiển thị) -->
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Details}" Spacing="6">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                        <!-- Cột 1: Mã hàng -->
                                                        <Label Grid.Column="0" 
                                                   Text="{Binding HhMa}" 
                                                   FontSize="11" 
                                                   TextColor="#64748B" 
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>

                                                        <!-- Cột 2: Tên hàng -->
                                                        <Label Grid.Column="1" 
                                                   Text="{Binding HhTen}" 
                                                   FontSize="12" 
                                                   TextColor="#0F172A" 
                                                   FontAttributes="Bold" 
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"/>

                                                        <!-- Cột 3: Số lượng + ĐVT -->
                                                        <Label Grid.Column="2" 
                                                   Text="{Binding SoLuongDvtFormatted}" 
                                                   FontSize="12" 
                                                   TextColor="#334155" 
                                                   HorizontalOptions="End"
                                                   VerticalOptions="Center"/>

                                                        <!-- Cột 4: Thành tiền -->
                                                        <Label Grid.Column="3" 
                                                   Text="{Binding ThanhTienFormatted}" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold" 
                                                   TextColor="#0F172A" 
                                                   HorizontalOptions="End"
                                                   VerticalOptions="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <BoxView HeightRequest="1" Color="#E2E8F0"/>

                                        <!-- KHỐI 4: TỔNG KẾT THANH TOÁN COD / ĐÃ THU (Luôn hiển thị) -->
                                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="4" BackgroundColor="#F8FAFC" Padding="8" Margin="0,2">
                                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                                <Label Text="Cần thu COD:" FontSize="12" TextColor="#64748B"/>
                                                <Label Text="{Binding ThanhToanSauBhFormatted}" FontSize="13" TextColor="#DC2626" FontAttributes="Bold"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                                <Label Text="Đã thu:" FontSize="12" TextColor="#64748B"/>
                                                <Label Text="{Binding TongDaThuFormatted}" FontSize="13" TextColor="#16A34A" FontAttributes="Bold"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                                <Label Text="💵 Tiền mặt:" FontSize="11" TextColor="#64748B"/>
                                                <Label Text="{Binding TienMatFormatted}" FontSize="11" TextColor="#1E293B" FontAttributes="Bold"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                                <Label Text="💳 Chuyển khoản:" FontSize="11" TextColor="#64748B"/>
                                                <Label Text="{Binding ChuyenKhoanFormatted}" FontSize="11" TextColor="#1E293B" FontAttributes="Bold"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <!-- KHỐI 5: NÚT THAO TÁC NGHIỆP VỤ (HỖ TRỢ VUỐT NGANG KHÔNG GIỚI HẠN NÚT) -->
                                        <VerticalStackLayout IsVisible="{Binding IsExpanded}">
                                            <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,4"/>

                                            <!-- Cho phép vuốt ngang (Horizontal) và ẩn thanh cuộn -->
                                            <ScrollView Orientation="Horizontal" 
                                                HorizontalScrollBarVisibility="Never" 
                                                Margin="0,2,0,0">
                                                <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                                                    <!-- 1. Tiếp nhận đơn -->
                                                    <Button Text="📥 Tiếp nhận đơn" FontSize="11" HeightRequest="32" Padding="12,0"
                                                        BackgroundColor="#16A34A" TextColor="White" CornerRadius="6"
                                                        IsVisible="{Binding CanTiepNhan}" Clicked="BtnGhTiepNhan_Clicked"/>
                                                    <!-- 2. Hủy tiếp nhận -->
                                                    <Button Text="↩️ Hủy tiếp nhận" FontSize="11" HeightRequest="32" Padding="10,0"
                                                        BackgroundColor="#EA580C" TextColor="White" CornerRadius="6"
                                                        IsVisible="{Binding CanHuyTiepNhan}" Clicked="BtnGhHuyTiepNhan_Clicked"/>
                                                    <!-- 3. BỔ SUNG: Nhập Serial (Hiện khi TinhTrang > 1) -->
                                                    <Button Text="🔢 Nhập Serial" FontSize="11" HeightRequest="32" Padding="10,0"
                                                        BackgroundColor="#0EA5E9" TextColor="White" CornerRadius="6"
                                                        IsVisible="{Binding CanNhapSerialInPhieu}" Clicked="BtnGhNhapSerial_Clicked"/>

                                                    <!-- 4. BỔ SUNG: In phiếu (Hiện khi TinhTrang > 1) -->
                                                    <Button Text="🖨️ In phiếu" FontSize="11" HeightRequest="32" Padding="10,0"
                                                        BackgroundColor="#6B21A8" TextColor="White" CornerRadius="6"
                                                        IsVisible="{Binding CanNhapSerialInPhieu}" Clicked="BtnGhInPhieu_Clicked"/>

                                                    <!-- 5. Giao thành công -->
                                                    <Button Text="✅ Giao thành công" FontSize="11" HeightRequest="32" Padding="12,0"
                                                        BackgroundColor="#2563EB" TextColor="White" CornerRadius="6"
                                                        IsVisible="{Binding CanGiaoThanhCong}" Clicked="BtnGhGiaoThanhCong_Clicked"/>
                                                    <!-- 6. Hủy đơn đã giao -->
                                                    <Button Text="🚫 Hủy đơn đã giao" FontSize="11" HeightRequest="32" Padding="10,0"
                                                        BackgroundColor="#DC2626" TextColor="White" CornerRadius="6"
                                                        IsVisible="{Binding CanHuyDaGiao}" Clicked="BtnGhHuyDaGiao_Clicked"/>
                                                    <!-- Bạn có thể thêm bất kỳ nút thao tác nào khác ở đây mà không lo vỡ khung -->
                                                </HorizontalStackLayout>
                                            </ScrollView>
                                        </VerticalStackLayout>
                                        <!-- KHỐI 5 KẾT THÚC -->
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,50" Spacing="8">
                                <Label Text="📭" FontSize="36" HorizontalOptions="Center"/>
                                <Label Text="Không tìm thấy đơn hàng nào" TextColor="#94A3B8" FontSize="13" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <ActivityIndicator x:Name="ActGiaoHangLoading" IsRunning="False" IsVisible="False" Color="#1E3A8A" HeightRequest="32" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,12,0,0"/>
                </Grid>

                <!-- 4. Footer Thống Kê -->
                <Grid x:Name="GridFooterThongKe" Grid.Row="3" RowDefinitions="Auto, Auto" BackgroundColor="White">
                    <BoxView Grid.Row="0" HeightRequest="1" Color="#E2E8F0"/>

                    <Grid Grid.Row="1" ColumnDefinitions="*, *" Padding="12,8">
                        <VerticalStackLayout Grid.Column="0">
                            <Label x:Name="LblTongSoDon" Text="Tổng đơn: 0" FontSize="11" TextColor="#475569"/>
                            <Label x:Name="LblTongPhaiThu" Text="Tổng cần thu: 0đ" FontSize="12" FontAttributes="Bold" TextColor="#DC2626"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                            <Label x:Name="LblTongSoLuongHang" Text="Số lượng hàng: 0" FontSize="11" TextColor="#475569" HorizontalOptions="End"/>
                            <Label x:Name="LblTongDaThuFooter" Text="Đã thu: 0đ" FontSize="12" FontAttributes="Bold" TextColor="#16A34A" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

            </Grid>

            <!-- TAB SERIAL HÀNG HOÁ -->
            <Grid x:Name="GridSerial" RowDefinitions="Auto, *, Auto" IsVisible="false">

                <!-- 1. Thanh Tìm Kiếm, Scan Barcode & Chọn Ngày -->
                <Frame Grid.Row="0" Margin="10,6" Padding="5,0" CornerRadius="12" BorderColor="#E0E0E0" HasShadow="True" BackgroundColor="White">
                    <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" ColumnSpacing="2" HeightRequest="44">
                        <Entry x:Name="txtSearchSerial" Grid.Column="0" TextChanged="OnSearchSerialTextChanged" Placeholder="Mã đơn, Serial, Khách hàng, SP..." VerticalOptions="Center" ClearButtonVisibility="WhileEditing" FontSize="13" TextColor="#0F172A" PlaceholderColor="#94A3B8" BackgroundColor="Transparent"/>
                        <Button x:Name="btnScanSerial" Grid.Column="1" Text="📷" Clicked="OnScanBarcodeSerialClicked" FontSize="17" HeightRequest="36" WidthRequest="32" Padding="0" BackgroundColor="Transparent"/>
                        <DatePicker x:Name="DpSerialTuNgay" Grid.Column="2" Format="dd/MM" FontSize="12" TextColor="#1E293B" HeightRequest="36" WidthRequest="56" VerticalOptions="Center" BackgroundColor="Transparent"/>
                        <DatePicker x:Name="DpSerialDenNgay" Grid.Column="3" Format="dd/MM" FontSize="12" TextColor="#1E293B" HeightRequest="36" WidthRequest="56" VerticalOptions="Center" BackgroundColor="Transparent"/>
                        <Button Grid.Column="4" Text="🔍" Clicked="OnTimKiemSerialClicked" FontSize="16" BackgroundColor="Transparent" TextColor="#333333" HeightRequest="36" WidthRequest="34" Padding="0"/>
                    </Grid>
                </Frame>

                <!-- 2. Danh Sách Đơn Hàng Serial -->
                <Grid Grid.Row="1" Margin="10,2">
                    <CollectionView x:Name="CvSerialList" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10" BackgroundColor="White" Margin="0,4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemSerialTapped"/>
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="6">

                                        <!-- HEADER: Số phiếu & Ngày lập -->
                                        <Grid ColumnDefinitions="*, Auto">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                                <Label Text="{Binding CtSo, StringFormat='Đơn: {0}'}" FontAttributes="Bold" TextColor="#1E3A8A" FontSize="14"/>
                                                <Label Text="{Binding NgayLapPhieu, StringFormat='({0:dd/MM/yyyy})'}" TextColor="#64748B" FontSize="12" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>

                                            <Label Grid.Column="1" Text="{Binding IconMoRong}" FontSize="14" VerticalOptions="Center" TextColor="#64748B"/>
                                        </Grid>

                                        <!-- THÔNG TIN KHÁCH HÀNG (Hiển thị khi DtID > 0) -->
                                        <Border IsVisible="{Binding HasKhachHang}"
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="6"
                                    Margin="0,2">
                                            <VerticalStackLayout Spacing="2">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="👤 Khách hàng:" FontAttributes="Bold" FontSize="12" TextColor="#334155"/>
                                                    <Label Text="{Binding DtTen}" FontAttributes="Bold" FontSize="12" TextColor="#0F172A" LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding DtMa, StringFormat='({0})'}" FontSize="12" TextColor="#64748B"/>
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding DtDiaChi, StringFormat='📍 {0}'}" IsVisible="{Binding DtDiaChi, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" FontSize="11" TextColor="#475569" LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding DtDienThoai, StringFormat='📞 {0}'}" IsVisible="{Binding DtDienThoai, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" FontSize="11" TextColor="#0284C7"/>
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- THÔNG TIN KHO XUẤT - NHẬP / NHÂN VIÊN -->
                                        <VerticalStackLayout Spacing="2">
                                            <HorizontalStackLayout IsVisible="{Binding HasKhoXuat}" Spacing="4">
                                                <Label Text="📤 Xuất kho:" FontSize="11" FontAttributes="Bold" TextColor="#D97706"/>
                                                <Label Text="{Binding NoiXuatTen}" FontSize="11" TextColor="#1E293B"/>
                                                <Label Text="{Binding NvXuatTen, StringFormat='- NV: {0}'}" IsVisible="{Binding NvXuatTen, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" FontSize="11" TextColor="#64748B"/>
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout IsVisible="{Binding HasKhoNhap}" Spacing="4">
                                                <Label Text="📥 Nhập kho:" FontSize="11" FontAttributes="Bold" TextColor="#16A34A"/>
                                                <Label Text="{Binding NoiNhapTen}" FontSize="11" TextColor="#1E293B"/>
                                                <Label Text="{Binding NvNhapTen, StringFormat='- NV: {0}'}" IsVisible="{Binding NvNhapTen, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" FontSize="11" TextColor="#64748B"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- SERIAL ĐÃ NHẬP CỦA TOÀN ĐƠN HÀNG -->
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="6" BackgroundColor="#FEF3C7">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <Label Grid.Column="0" Text="🏷️ Serial: " FontAttributes="Bold" FontSize="11" TextColor="#B45309" VerticalOptions="Start"/>
                                                <Label Grid.Column="1" IsVisible="{Binding HasSerial}" Text="{Binding TongSerialChuoi}" FontSize="11" TextColor="#78350F" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                                                <Label Grid.Column="1" IsVisible="{Binding HasSerial, Converter={StaticResource InverseBoolConverter}}" Text="Chưa nhập Serial" FontSize="11" TextColor="#DC2626" FontAttributes="Italic"/>
                                            </Grid>
                                        </Border>

                                        <!-- CHI TIẾT CÁC MẶT HÀNG TRONG ĐƠN (LUÔN HIỂN THỊ) -->
                                        <VerticalStackLayout Spacing="4" Margin="0,2,0,0">
                                            <BoxView HeightRequest="1" Color="#E2E8F0"/>
                                            <Label Text="Chi tiết mặt hàng:" FontAttributes="Bold" FontSize="12" TextColor="#334155"/>

                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Details}" Spacing="4">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="6" BackgroundColor="#F8FAFC">
                                                            <VerticalStackLayout Spacing="3">
                                                                <Grid ColumnDefinitions="*, Auto">
                                                                    <HorizontalStackLayout Spacing="4">
                                                                        <Label Text="{Binding HhMa, StringFormat='[{0}]'}" FontAttributes="Bold" TextColor="#EA580C" FontSize="11"/>
                                                                        <Label Text="{Binding HhTen}" FontAttributes="Bold" TextColor="#0F172A" FontSize="11" LineBreakMode="TailTruncation"/>
                                                                    </HorizontalStackLayout>
                                                                    <Label Grid.Column="1" Text="{Binding SoLuong, StringFormat='SL: {0}'}" FontAttributes="Bold" TextColor="#2563EB" FontSize="11"/>
                                                                </Grid>

                                                                <HorizontalStackLayout Spacing="4">
                                                                    <Label Text="Serial:" FontSize="10" TextColor="#64748B"/>
                                                                    <Label Text="{Binding SerialChuoi}" FontSize="10" TextColor="#16A34A" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                                                </HorizontalStackLayout>
                                                            </VerticalStackLayout>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- KHỐI 2 NÚT THAO TÁC (ẨN/HIỆN KHI BẤM VÀO ITEM: ISEXPANDED = TRUE) -->
                                        <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="6" Margin="0,4,0,0">
                                            <BoxView HeightRequest="1" Color="#CBD5E1"/>
                                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,2">
                                                <HorizontalStackLayout Spacing="8" HorizontalOptions="Start">

                                                    <!-- 1. Nút Nhập Serial -->
                                                    <Button Text="🔢 Nhập Serial" 
                                                FontSize="11" 
                                                FontAttributes="Bold"
                                                HeightRequest="32" 
                                                Padding="12,0"
                                                BackgroundColor="#0EA5E9" 
                                                TextColor="White" 
                                                CornerRadius="6"
                                                Clicked="OnMoPageNhapSerialClicked"/>

                                                    <!-- 2. Nút In phiếu -->
                                                    <Button Text="🖨️ In phiếu" 
                                                FontSize="11" 
                                                FontAttributes="Bold"
                                                HeightRequest="32" 
                                                Padding="12,0"
                                                BackgroundColor="#6B21A8" 
                                                TextColor="White" 
                                                CornerRadius="6"
                                                Clicked="OnInChungTuSerialClicked"/>

                                                </HorizontalStackLayout>
                                            </ScrollView>
                                        </VerticalStackLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40">
                                <Label Text="Không tìm thấy chứng từ Serial nào" TextColor="#94A3B8" FontSize="13"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <ActivityIndicator x:Name="ActSerialLoading" IsRunning="False" IsVisible="False" Color="#1E3A8A" HeightRequest="30" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,10,0,0"/>
                </Grid>
            </Grid>

            <!-- TAB F - TÀI KHOẢN -->
            <ScrollView x:Name="AccountContent" IsVisible="False">
                <VerticalStackLayout Padding="16" Spacing="16">

                    <!-- 1. THANH TRẠNG THÁI DẪN HƯỚNG & HÀNH ĐỘNG -->
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                        <!-- Nút Đăng nhập -->
                        <Button
                            x:Name="btnLogin"
                            Grid.Column="0"
                            BackgroundColor="#EE4D2D"
                            Clicked="OnLoginClicked"
                            CornerRadius="8"
                            FontSize="13"
                            HeightRequest="40"
                            IsEnabled="True"
                            Text="Đăng nhập"
                            TextColor="White" />

                        <!-- Nút Đăng xuất -->
                        <Button
                            x:Name="btnLogout"
                            Grid.Column="1"
                            BackgroundColor="#888888"
                            Clicked="OnLogoutClicked"
                            CornerRadius="8"
                            FontSize="13"
                            HeightRequest="40"
                            IsEnabled="False"
                            Text="Đăng xuất"
                            TextColor="White" />

                        <!-- Nút Cấu hình -->
                        <Button
                            x:Name="btnSettings"
                            Grid.Column="2"
                            BackgroundColor="#333333"
                            Clicked="OnSettingsClicked"
                            CornerRadius="8"
                            FontSize="13"
                            HeightRequest="40"
                            Text="Cấu hình"
                            TextColor="White" />
                    </Grid>

                    <!-- 2. LOGO VÀ THÔNG TIN TÀI KHOẢN -->
                    <Border
                        Padding="16,16,16,16"
                        BackgroundColor="White"
                        Stroke="#EAEAEA"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">

                        <VerticalStackLayout Spacing="12">
                            <!-- Avatar & Nút Sửa -->
                            <Grid
                                HorizontalOptions="Center"
                                HeightRequest="90"
                                WidthRequest="90">
                                <Border
                                    HeightRequest="80"
                                    HorizontalOptions="Center"
                                    Stroke="#EE4D2D"
                                    StrokeShape="RoundRectangle 40"
                                    StrokeThickness="2"
                                    VerticalOptions="Center"
                                    WidthRequest="80">
                                    <Image
                                    x:Name="imgAvatar"
                                    Aspect="AspectFill"
                                    Source="user_avatar.png" />
                                </Border>

                                <!-- Icon Sửa Ảnh -->
                                <Border
                                    BackgroundColor="#EE4D2D"
                                    HeightRequest="28"
                                    HorizontalOptions="End"
                                    Stroke="White"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="2"
                                    VerticalOptions="End"
                                    WidthRequest="28">
                                    <Image Source="ic_edit.png" Margin="4" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEditAvatarTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>

                            <!-- Thông tin cá nhân -->
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label
                                    x:Name="lblFullName"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalTextAlignment="Center"
                                    Text="Nguyễn Văn A"
                                    TextColor="#222222" />
                                <Label
                                    x:Name="lblPhone"
                                    FontSize="13"
                                    HorizontalTextAlignment="Center"
                                    Text="0901234567"
                                    TextColor="#666666" />
                                <Label
                                    x:Name="lblEmail"
                                    FontSize="13"
                                    HorizontalTextAlignment="Center"
                                    Text="nguyenvana@gmail.com"
                                    TextColor="#666666" />
                                <Label
                                    x:Name="lblAddress"
                                    FontSize="13"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    Text="123 Đường ABC, Phường X, Quận Y, TP.HCM"
                                    TextColor="#666666" />
                                <Label
                                    x:Name="lblBirthday"
                                    FontSize="13"
                                    HorizontalTextAlignment="Center"
                                    Text="Ngày sinh: 01/01/1990"
                                    TextColor="#666666" />
                            </VerticalStackLayout>

                            <BoxView
                                HeightRequest="1"
                                Margin="0,4"
                                Color="#EEEEEE" />

                            <!-- Cấp thành viên -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label
                                        FontSize="11"
                                        Text="HẠNG THÀNH VIÊN"
                                        TextColor="#888888" />
                                    <Label
                                        x:Name="lblMemberRank"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Vàng (Gold)"
                                        TextColor="#D4AF37" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1">
                                    <Label
                                        FontSize="11"
                                        Text="ƯU ĐÃI HIỆN CÓ"
                                        TextColor="#888888" />
                                    <Label
                                        x:Name="lblMemberPrivilege"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        Text="Giảm 10% các dịch vụ"
                                        TextColor="#EE4D2D" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. THÔNG TIN TÀI CHÍNH & TÍCH ĐIỂM -->
                    <Border
                        Padding="16"
                        BackgroundColor="White"
                        Stroke="#EAEAEA"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">

                        <VerticalStackLayout Spacing="12">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="Tài chính &amp; Ưu đãi"
                                TextColor="#222222" />

                            <Grid
                                ColumnDefinitions="*, *"
                                RowDefinitions="Auto, Auto"
                                RowSpacing="12">
                                <!-- Số dư tiền mặt -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                    <Label
                                        FontSize="12"
                                        Text="Số dư tiền mặt"
                                        TextColor="#777777" />
                                    <Label
                                        x:Name="lblCashBalance"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="1.500.000 đ"
                                        TextColor="#2E7D32" />
                                </VerticalStackLayout>

                                <!-- Số dư tích điểm -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                    <Label
                                        FontSize="12"
                                        Text="Điểm tích lũy"
                                        TextColor="#777777" />
                                    <Label
                                        x:Name="lblPointBalance"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="2,450 điểm"
                                        TextColor="#EE4D2D" />
                                </VerticalStackLayout>

                                <!-- Voucher đã dùng -->
                                <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                                    <Label
                                        FontSize="12"
                                        Text="Voucher đã dùng"
                                        TextColor="#777777" />
                                    <Label
                                        x:Name="lblUsedVouchers"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="12 Voucher"
                                        TextColor="#333333" />
                                </VerticalStackLayout>

                                <!-- Xem đổi điểm lấy quà -->
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Padding="8,0"
                                    BackgroundColor="#FFF3F0"
                                    HeightRequest="36"
                                    Stroke="#FFE0D5"
                                    StrokeShape="RoundRectangle 6"
                                    VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalOptions="Center"
                                        Text="Đổi điểm lấy quà >"
                                        TextColor="#EE4D2D"
                                        VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRedeemPointsTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 4. TRỢ GIÚP -->
                    <Border
                        Padding="8,0"
                        BackgroundColor="White"
                        Stroke="#EAEAEA"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">

                        <VerticalStackLayout>
                            <!-- Trung tâm trợ giúp (Chat) -->
                            <Grid
                                Padding="12"
                                ColumnDefinitions="Auto, *, Auto"
                                ColumnSpacing="12">
                                <Label
                                    Grid.Column="0"
                                    FontSize="18"
                                    Text="💬"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="Trung tâm trợ giúp (Chat)"
                                    TextColor="#333333"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontSize="14"
                                    Text=">"
                                    TextColor="#AAAAAA"
                                    VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHelpCenterChatTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Margin="12,0"
                                Color="#F0F0F0" />

                            <!-- Chăm sóc khách hàng (Hotline) -->
                            <Grid
                                Padding="12"
                                ColumnDefinitions="Auto, *, Auto"
                                ColumnSpacing="12">
                                <Label
                                    Grid.Column="0"
                                    FontSize="18"
                                    Text="📞"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="Chăm sóc khách hàng (Hotline)"
                                    TextColor="#333333"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontSize="14"
                                    Text="1900 xxxx"
                                    TextColor="#EE4D2D"
                                    VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHotlineTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <!-- ===================================================== -->
        <!-- FOOTER 6 TAB (TRANG CHỦ ĐIỀU HƯỚNG TỚI DASHBOARD) -->
        <!-- ===================================================== -->
        <Border Grid.Row="3"
            BackgroundColor="White"
            Padding="0"
            Margin="0"
            Stroke="#E0E0E0"
            StrokeThickness="1">
            <Grid x:Name="gridFooter" Margin="0" Padding="0">
                <!-- TAB 1 - TRANG CHỦ (DASHBOARD) -->
                <Grid x:Name="tabDashboard" Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="0">
                    <Label x:Name="lblIconDashboard" Grid.Row="0" FontFamily="MaterialIcons" FontSize="22" HorizontalOptions="Center" Text="&#xe871;" TextColor="#888888" />
                    <Label x:Name="lblTextDashboard" Grid.Row="1" FontSize="11" HorizontalTextAlignment="Center" Text="Trang chủ" TextColor="#888888" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabDashboardClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
                <!-- TAB 2 - SẢN PHẨM (HOME CŨ DỜI SANG) -->
                <Grid x:Name="tabProduct" Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="0">
                    <Label x:Name="lblIconProduct" Grid.Row="0" FontFamily="MaterialIcons" FontSize="21" HorizontalOptions="Center" Text="&#xe8b9;" TextColor="#888888" />
                    <Label x:Name="lblTextProduct" Grid.Row="1" FontSize="11" HorizontalTextAlignment="Center" Text="Sản phẩm" TextColor="#888888" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabProductClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
                <!-- TAB 3 - CUỘC GỌI -->
                <Grid x:Name="tabCall" Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="0">
                    <Label x:Name="lblIconCall" Grid.Row="0" FontFamily="MaterialIcons" FontSize="21" HorizontalOptions="Center" Text="&#xe0cd;" TextColor="#888888" />
                    <Label x:Name="lblTextCall" Grid.Row="1" FontSize="11" HorizontalTextAlignment="Center" Text="Cuộc gọi" TextColor="#888888" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabCallClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
                <!-- TAB 4 - ĐƠN HÀNG -->
                <Grid x:Name="tabOrder" Grid.Column="3" RowDefinitions="Auto,Auto" RowSpacing="0">
                    <Label x:Name="lblIconOrder" Grid.Row="0" FontFamily="MaterialIcons" FontSize="21" HorizontalOptions="Center" Text="&#xe8b0;" TextColor="#888888" />
                    <Label x:Name="lblTextOrder" Grid.Row="1" FontSize="11" HorizontalTextAlignment="Center" Text="Đơn hàng" TextColor="#888888" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabOrderClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
                <!-- TAB 5 - SERIAL HÀNG HOÁ -->
                <Grid x:Name="tabTask" Grid.Column="4" RowDefinitions="Auto,Auto" RowSpacing="0">
                    <Label x:Name="lblIconTask" Grid.Row="0" FontFamily="MaterialIcons" FontSize="21" HorizontalOptions="Center" Text="&#xe8f9;" TextColor="#888888" />
                    <Label x:Name="lblTextTask" Grid.Row="1" FontSize="11" HorizontalTextAlignment="Center" Text="Serial SP" TextColor="#888888" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabSerialClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
                <!-- TAB 6 - TÀI KHOẢN -->
                <Grid x:Name="tabAccount" Grid.Column="5" RowDefinitions="Auto,Auto" RowSpacing="0">
                    <Label x:Name="lblIconAccount" Grid.Row="0" FontFamily="MaterialIcons" FontSize="21" HorizontalOptions="Center" Text="&#xe7fd;" TextColor="#888888" />
                    <Label x:Name="lblTextAccount" Grid.Row="1" FontSize="11" HorizontalTextAlignment="Center" Text="Tài khoản" TextColor="#888888" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabAccountClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</ContentPage>